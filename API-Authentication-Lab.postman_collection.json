{
  "info": {
    "name": "API Authentication Learning Lab",
    "description": "Postman requests for testing JWT authentication and role-based authorization. Set collection variables baseUrl, access_token, and admin_token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Login - regular user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('access_token', pm.response.json().access_token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student\",\n  \"password\": \"Student@123\"\n}"
        },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "Profile - without token (expect 401)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/profile"
      }
    },
    {
      "name": "Profile - with token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{baseUrl}}/api/profile"
      }
    },
    {
      "name": "Admin - regular user token (expect 403)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin"
      }
    },
    {
      "name": "Login - admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.collectionVariables.set('admin_token', pm.response.json().access_token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
        },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "Admin - with admin token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin"
      }
    },
    {
      "name": "Login - wrong password (expect 401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student\",\n  \"password\": \"wrong-password\"\n}"
        },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "Register a new user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"newstudent\",\n  \"password\": \"StrongPass123!\"\n}"
        },
        "url": "{{baseUrl}}/register"
      }
    },
    {
      "name": "Profile - malformed token (expect 401)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer not.a.valid.token"
          }
        ],
        "url": "{{baseUrl}}/api/profile"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    }
  ]
}